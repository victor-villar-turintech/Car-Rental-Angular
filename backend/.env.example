# Copy this file to .env and adjust as needed.

# HTTP server
PORT=3001

# JWT signing secret (CHANGE IN PRODUCTION)
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=12h

# Path to the SQLite database file. Relative paths resolve from backend/dist
# when running the compiled build, or backend/ when running with ts-node-dev.
# SQLITE_PATH=./data/rentacar.sqlite
